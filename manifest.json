{
  "manifest_version": 3,
  "name": "Sparx Science Study Assistant",
  "version": "2.0.0",
  "description": "识别 Sparx Science 当前题目并生成可复核答案",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://science.sparx-learning.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://science.sparx-learning.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon128.png",
    "16": "icon16.png",
    "48": "icon48.png",
    "32": "icon32.png"
  }
}
